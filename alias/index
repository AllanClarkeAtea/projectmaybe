// ═══════════════════════════════════════════════════════════════════
//  CONSTANTS
// ═══════════════════════════════════════════════════════════════════
const TEAM_COLORS   = ['#7c5cfc','#4fd1c5','#f6c90e','#f87171','#34d399','#fb923c','#a78bfa','#38bdf8'];
const TEAM_DEFAULTS = ['Lag 1','Lag 2','Lag 3','Lag 4'];
const CAT_META = {
  persons: { cls: 'cat-persons', label: 'Kjente personer', icon: '👤' },
  land:    { cls: 'cat-land',    label: 'Land',            icon: '🌍' },
  capital: { cls: 'cat-capital', label: 'Hovedstader',     icon: '🏛️' },
};

// ═══════════════════════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════════════════════
let state = {
  teams: [], wordPool: [], usedWords: new Set(),
  currentTeamIdx: 0, roundNumber: 0,
  targetScore: 30, roundTime: 60,
  activeCategories: ['persons','land','capital'],
  gamePhase: 'setup',
  currentWord: null, roundWordCount: 0,
  timerInterval: null, timeLeft: 60,
  roundScore: 0,
  winnerTeamIdx: -1, equalizingUntilIdx: -1,
};

// ═══════════════════════════════════════════════════════════════════
//  SCREEN MANAGEMENT
// ═══════════════════════════════════════════════════════════════════
function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => {
    const active = s.id === 'screen-' + name;
    s.classList.toggle('active', active);
    s.setAttribute('aria-hidden', active ? 'false' : 'true');
  });
  // Move keyboard focus to the new screen's first heading or button
  requestAnimationFrame(() => {
    const screen = document.getElementById('screen-' + name);
    const focusTarget = screen.querySelector('h1,h2,button');
    if (focusTarget) {
      focusTarget.setAttribute('tabindex', '-1');
      focusTarget.focus({ preventScroll: false });
    }
  });
}

// ═══════════════════════════════════════════════════════════════════
//  LIVE REGION HELPERS
// ═══════════════════════════════════════════════════════════════════
function announce(msg, urgent = false) {
  const el = document.getElementById(urgent ? 'sr-live-urgent' : 'sr-live');
  el.textContent = '';
  requestAnimationFrame(() => { el.textContent = msg; });
}

// ═══════════════════════════════════════════════════════════════════
//  SETUP SCREEN
// ═══════════════════════════════════════════════════════════════════
function initSetup() {
  state.teams = [];
  TEAM_DEFAULTS.slice(0,2).forEach((n,i) => {
    state.teams.push({ name: n, score: 0, rounds: 0, color: TEAM_COLORS[i] });
  });
  renderTeamList();
}

function renderTeamList() {
  const el = document.getElementById('teams-list');
  el.innerHTML = '';
  state.teams.forEach((t, i) => {
    const item = document.createElement('div');
    item.setAttribute('role','listitem');
    item.style.cssText = 'display:flex;align-items:center;gap:10px';
    item.innerHTML = `
      <div class="team-dot" style="background:${t.color}" aria-hidden="true"></div>
      <label for="team-name-${i}" class="sr-only">Navn på lag ${i+1}</label>
      <input type="text" id="team-name-${i}" value="${escHtml(t.name)}"
             placeholder="Lagnavn" style="flex:1"
             onchange="updateTeamName(${i}, this.value)"
             aria-label="Navn på lag ${i+1}">
      ${state.teams.length > 2
        ? `<button class="btn btn-red btn-sm" onclick="removeTeam(${i})"
                   aria-label="Fjern ${escHtml(t.name)}" style="padding:6px 10px;min-width:44px">✕</button>`
        : ''}
    `;
    el.appendChild(item);
  });
}

function addTeam() {
  if (state.teams.length >= 8) return;
  const i = state.teams.length;
  state.teams.push({ name: TEAM_DEFAULTS[i] || `Lag ${i+1}`, score: 0, rounds: 0, color: TEAM_COLORS[i] });
  renderTeamList();
  // Focus the new input
  requestAnimationFrame(() => {
    const inp = document.getElementById(`team-name-${i}`);
    if (inp) inp.focus();
  });
}

function removeTeam(i) {
  const name = state.teams[i].name;
  state.teams.splice(i, 1);
  renderTeamList();
  announce(`${name} er fjernet.`);
}

function updateTeamName(i, val) {
  state.teams[i].name = val.trim() || `Lag ${i+1}`;
}

// ═══════════════════════════════════════════════════════════════════
//  START GAME
// ═══════════════════════════════════════════════════════════════════
function startGame() {
  const cats = [];
  if (document.getElementById('cat-persons').checked) cats.push('persons');
  if (document.getElementById('cat-land').checked)    cats.push('land');
  if (document.getElementById('cat-capital').checked) cats.push('capital');
  if (cats.length === 0) {
    announce('Velg minst én kategori!', true);
    document.getElementById('cat-persons').focus();
    return;
  }
  if (state.teams.length < 2) {
    announce('Legg til minst 2 lag!', true);
    return;
  }
  state.activeCategories   = cats;
  state.targetScore        = parseInt(document.getElementById('target-score').value);
  state.roundTime          = parseInt(document.getElementById('round-time').value);
  state.currentTeamIdx     = 0;
  state.roundNumber        = 0;
  state.gamePhase          = 'playing';
  state.usedWords          = new Set();
  state.winnerTeamIdx      = -1;
  state.equalizingUntilIdx = -1;
  state.teams.forEach(t => { t.score = 0; t.rounds = 0; });
  buildWordPool();
  showDashboard();
}

function buildWordPool() {
  state.wordPool = [];
  state.activeCategories.forEach(cat => {
    WORDS[cat].forEach(w => state.wordPool.push({ ...w, category: cat }));
  });
  shuffleArray(state.wordPool);
}

// ═══════════════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════════════
function showDashboard() {
  const team = state.teams[state.currentTeamIdx];
  document.getElementById('dash-team-name').textContent = team.name + ' sin tur';

  const dot = document.getElementById('dash-team-dot');
  dot.style.background = team.color;
  dot.setAttribute('aria-label', 'Lagfarge: ' + team.color);

  document.getElementById('dash-round').textContent  = state.roundNumber + 1;
  document.getElementById('dash-target').textContent = state.targetScore;
  document.getElementById('dash-time').textContent   = state.roundTime + 's';

  const notice = document.getElementById('final-round-notice');
  if (state.gamePhase === 'equalizing') {
    notice.removeAttribute('hidden');
  } else {
    notice.setAttribute('hidden','');
  }

  renderDashScoreboard();
  announce(`${team.name} sin tur. Runde ${state.roundNumber + 1}.`);
  showScreen('dashboard');
}

function renderDashScoreboard() {
  const el = document.getElementById('dash-scoreboard');
  const sorted = [...state.teams].sort((a,b) => b.score - a.score);
  el.innerHTML = sorted.map((t, rank) => {
    const isActive = t === state.teams[state.currentTeamIdx];
    const isLeader = rank === 0 && t.score > 0;
    return `
      <div class="score-row ${isLeader?'leader':''} ${isActive?'active-turn':''}"
           role="listitem"
           aria-label="${escHtml(t.name)}: ${t.score} poeng${isActive?' – din tur':''}${isLeader?' – leder':''}">
        <div style="display:flex;align-items:center;gap:10px">
          <div class="team-dot" style="background:${t.color}" aria-hidden="true"></div>
          <span style="font-weight:500">${escHtml(t.name)}</span>
          ${isActive ? '<span style="font-size:0.7rem;color:var(--c-accent);background:rgba(124,92,252,0.15);padding:2px 8px;border-radius:999px" aria-hidden="true">DIN TUR</span>' : ''}
        </div>
        <span class="font-display font-bold text-xl" aria-hidden="true">${t.score}</span>
      </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════════════════
//  GAMEPLAY
// ═══════════════════════════════════════════════════════════════════
function startRound() {
  const team = state.teams[state.currentTeamIdx];
  state.roundScore    = 0;
  state.roundWordCount= 0;
  state.timeLeft      = state.roundTime;

  document.getElementById('game-team-name').textContent = team.name;
  document.getElementById('game-team-name').setAttribute('aria-label', 'Laget som forklarer: ' + team.name);
  document.getElementById('game-score').textContent = team.score;

  // Hide hint
  setHintVisible(false);

  loadNextWord();
  updateTimerDisplay();
  showScreen('game');

  clearInterval(state.timerInterval);
  state.timerInterval = setInterval(tickTimer, 1000);
}

function loadNextWord() {
  setHintVisible(false);

  const team = state.teams[state.currentTeamIdx];
  const idx  = (team.score + state.roundWordCount) % state.wordPool.length;
  let candidate = null;
  for (let i = 0; i < state.wordPool.length; i++) {
    const w = state.wordPool[(idx + i) % state.wordPool.length];
    if (!state.usedWords.has(w.word)) { candidate = w; break; }
  }
  if (!candidate) {
    state.usedWords = new Set();
    candidate = state.wordPool[idx % state.wordPool.length];
  }
  state.currentWord = candidate;
  state.usedWords.add(candidate.word);
  state.roundWordCount++;

  document.getElementById('game-word').textContent       = candidate.word;
  document.getElementById('word-counter').textContent    = state.roundWordCount;
  document.getElementById('hint-box').textContent        = candidate.hint;

  const meta = CAT_META[candidate.category];
  const badge = document.getElementById('game-cat-badge');
  badge.className   = 'cat-badge ' + meta.cls;
  badge.textContent = meta.icon + ' ' + meta.label;

  // Announce new word to screen readers
  announce(`Nytt ord: ${candidate.word}. Kategori: ${meta.label}.`);
}

function setHintVisible(visible) {
  const box = document.getElementById('hint-box');
  const btn = document.getElementById('hint-btn');
  if (visible) {
    box.removeAttribute('hidden');
    btn.textContent = '💡 Skjul hint';
    btn.setAttribute('aria-expanded','true');
  } else {
    box.setAttribute('hidden','');
    btn.innerHTML = '<span aria-hidden="true">💡</span> Vis hint';
    btn.setAttribute('aria-expanded','false');
  }
}

function toggleHint() {
  const hidden = document.getElementById('hint-box').hasAttribute('hidden');
  setHintVisible(hidden);
  if (hidden) announce('Hint: ' + state.currentWord.hint);
}

function correctAnswer() {
  const team = state.teams[state.currentTeamIdx];
  team.score++;
  state.roundScore++;
  document.getElementById('game-score').textContent = team.score;
  flashPoint('+1', true);
  announce(`Riktig! ${team.name} har nå ${team.score} poeng.`);
  loadNextWord();
}

function wrongAnswer() {
  const team = state.teams[state.currentTeamIdx];
  team.score = Math.max(0, team.score - 1);
  state.roundScore--;
  document.getElementById('game-score').textContent = team.score;
  flashPoint('−1', false);
  announce(`Hopp over. ${team.name} har nå ${team.score} poeng.`);
  loadNextWord();
}

function flashPoint(text, positive) {
  const el = document.createElement('div');
  el.className   = 'point-flash ' + (positive ? 'flash-pos' : 'flash-neg');
  el.textContent = text;
  el.setAttribute('aria-hidden','true');
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 800);
}

// ═══════════════════════════════════════════════════════════════════
//  TIMER
// ═══════════════════════════════════════════════════════════════════
function tickTimer() {
  state.timeLeft--;
  updateTimerDisplay();
  // Announce at key thresholds for screen readers
  if ([30, 10, 5].includes(state.timeLeft)) {
    announce(`${state.timeLeft} sekunder igjen.`, state.timeLeft <= 10);
  }
  if (state.timeLeft <= 0) {
    clearInterval(state.timerInterval);
    announce('Tiden er ute!', true);
    timeUp();
  }
}

function updateTimerDisplay() {
  const t = state.timeLeft;
  document.getElementById('timer-display').textContent = t;

  const circumference = 2 * Math.PI * 30;
  const fraction      = t / state.roundTime;
  const arc           = document.getElementById('timer-arc');
  arc.style.strokeDashoffset = circumference * (1 - fraction);

  let color = '#7c5cfc';
  if      (fraction < 0.33) color = '#f87171';
  else if (fraction < 0.60) color = '#f6c90e';
  arc.style.stroke = color;
  document.getElementById('timer-display').style.color = fraction < 0.33 ? '#f87171' : 'var(--c-text)';
}

// ═══════════════════════════════════════════════════════════════════
//  OVERTIME
// ═══════════════════════════════════════════════════════════════════
function timeUp() {
  state.teams[state.currentTeamIdx].rounds++;
  const w = state.currentWord;

  document.getElementById('ot-word').textContent = w.word;
  document.getElementById('ot-hint-box').textContent = w.hint;
  document.getElementById('ot-hint-box').setAttribute('hidden','');

  // Reset hint button
  const otBtn = document.querySelector('#screen-overtime .btn-hint');
  if (otBtn) { otBtn.setAttribute('aria-expanded','false'); otBtn.innerHTML = '<span aria-hidden="true">💡</span> Hint'; }

  const meta = CAT_META[w.category];
  const ob   = document.getElementById('ot-cat-badge');
  ob.className   = 'cat-badge ' + meta.cls;
  ob.textContent = meta.icon + ' ' + meta.label;

  const btns = document.getElementById('ot-team-buttons');
  btns.innerHTML = state.teams.map((t,i) => `
    <button class="btn btn-ghost"
            style="border-color:${t.color};justify-content:flex-start;gap:12px;padding:1rem 1.25rem;"
            onclick="overtimeTeamGuessed(${i})"
            aria-label="${escHtml(t.name)} gjettet riktig – gi dem poenget">
      <div class="team-dot" style="background:${t.color};width:12px;height:12px" aria-hidden="true"></div>
      <span>${escHtml(t.name)}</span>
      <span style="margin-left:auto;font-size:0.85rem;color:var(--c-muted)" aria-hidden="true">${t.score} p</span>
    </button>`).join('');

  announce(`Utjevning! Overtidsordet er: ${w.word}. Kategori: ${meta.label}. Hvem gjettet riktig?`, true);
  showScreen('overtime');
}

function toggleOtHint() {
  const box = document.getElementById('ot-hint-box');
  const btn = document.querySelector('#screen-overtime .btn-hint');
  const hidden = box.hasAttribute('hidden');
  if (hidden) {
    box.removeAttribute('hidden');
    btn.setAttribute('aria-expanded','true');
    announce('Hint: ' + state.currentWord.hint);
  } else {
    box.setAttribute('hidden','');
    btn.setAttribute('aria-expanded','false');
  }
}

function overtimeTeamGuessed(teamIdx) {
  const team = state.teams[teamIdx];
  team.score++;
  announce(`${team.name} fikk overtidspoeng. Ny score: ${team.score}.`);
  afterRound();
}

function skipOvertime() { afterRound(); }

// ═══════════════════════════════════════════════════════════════════
//  ROUND TRANSITIONS
// ═══════════════════════════════════════════════════════════════════
function afterRound() {
  const numTeams    = state.teams.length;
  const prevTeamIdx = state.currentTeamIdx;

  if (state.gamePhase === 'playing') {
    const leaderScore = Math.max(...state.teams.map(t => t.score));
    if (leaderScore >= state.targetScore) {
      const leaderIdx           = state.teams.findIndex(t => t.score === leaderScore);
      state.winnerTeamIdx       = leaderIdx;
      state.gamePhase           = 'equalizing';
      state.equalizingUntilIdx  = (leaderIdx + numTeams - 1) % numTeams;
    }
  }

  state.currentTeamIdx = (state.currentTeamIdx + 1) % numTeams;
  if (state.currentTeamIdx === 0) state.roundNumber++;

  if (state.gamePhase === 'equalizing' && prevTeamIdx === state.equalizingUntilIdx) {
    endGame();
    return;
  }

  showDashboard();
}

// ═══════════════════════════════════════════════════════════════════
//  END GAME
// ═══════════════════════════════════════════════════════════════════
function endGame() {
  const sorted = [...state.teams].sort((a,b) => b.score - a.score);
  const winner = sorted[0];
  const ties   = sorted.filter(t => t.score === winner.score);

  const winnerName = ties.length > 1 ? ties.map(t=>t.name).join(' & ') : winner.name;
  const winnerSub  = ties.length > 1
    ? `Uavgjort med ${winner.score} poeng!`
    : `Med ${winner.score} poeng – Gratulerer!`;

  document.getElementById('winner-name').textContent = winnerName;
  document.getElementById('winner-sub').textContent  = winnerSub;

  const medals = ['🥇','🥈','🥉'];
  document.getElementById('winner-scoreboard').innerHTML = sorted.map((t, rank) => `
    <div class="score-row ${rank===0?'leader':''}"
         role="listitem"
         aria-label="${rank+1}. plass: ${escHtml(t.name)} med ${t.score} poeng">
      <div style="display:flex;align-items:center;gap:10px">
        <span aria-hidden="true" style="font-size:1.1rem">${medals[rank] || (rank+1)+'.'}</span>
        <div class="team-dot" style="background:${t.color}" aria-hidden="true"></div>
        <span style="font-weight:500">${escHtml(t.name)}</span>
      </div>
      <span class="font-display font-bold text-xl"
            style="color:${rank===0?'var(--c-gold)':'inherit'}"
            aria-hidden="true">${t.score}</span>
    </div>`).join('');

  announce(`Spillet er over! Vinner: ${winnerName}. ${winnerSub}`, true);
  showScreen('winner');
  spawnConfetti();
}

// ═══════════════════════════════════════════════════════════════════
//  CONFETTI
// ═══════════════════════════════════════════════════════════════════
function spawnConfetti() {
  // Skip if user prefers reduced motion
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const colors = ['#7c5cfc','#4fd1c5','#f6c90e','#f87171','#34d399','#fb923c'];
  for (let i = 0; i < 80; i++) {
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'confetti-piece';
      el.setAttribute('aria-hidden','true');
      el.style.cssText = `
        left:${Math.random()*100}vw;
        background:${colors[Math.floor(Math.random()*colors.length)]};
        animation-duration:${2+Math.random()*2}s;
        animation-delay:${Math.random()*0.5}s;
        transform:rotate(${Math.random()*360}deg);
        width:${6+Math.random()*8}px;height:${6+Math.random()*8}px;
        border-radius:${Math.random()>0.5?'50%':'2px'};
      `;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 4500);
    }, i * 30);
  }
}

// ═══════════════════════════════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════════════════════════════
function restartGame() {
  state.teams.forEach(t => { t.score = 0; t.rounds = 0; });
  state.currentTeamIdx = 0; state.roundNumber = 0;
  state.gamePhase = 'playing'; state.usedWords = new Set();
  state.winnerTeamIdx = -1; state.equalizingUntilIdx = -1;
  buildWordPool();
  showDashboard();
}

function goToSetup() {
  clearInterval(state.timerInterval);
  showScreen('setup');
}

// ═══════════════════════════════════════════════════════════════════
//  UTILITIES
// ═══════════════════════════════════════════════════════════════════
function shuffleArray(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
}

// Prevent XSS in dynamically inserted team names
function escHtml(str) {
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// ═══════════════════════════════════════════════════════════════════
//  BOOT
// ═══════════════════════════════════════════════════════════════════
initSetup();
</script>
