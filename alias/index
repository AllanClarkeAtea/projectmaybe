<!DOCTYPE html>
<html lang="no">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alias – Norsk Utgave</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
<style>
  /* ── Colour tokens ─────────────────────────────────────────────── */
  :root {
    --c-bg:      #0a0a0f;
    --c-surface: #13131a;
    --c-surface2:#1c1c27;
    --c-border:  rgba(255,255,255,0.10);
    --c-accent:  #7c5cfc;
    --c-gold:    #f6c90e;
    --c-green:   #34d399;
    --c-red:     #f87171;
    --c-text:    #f0eeff;
    /* WCAG fix: replaced rgba(240,238,255,0.45) ≈ 2.8:1 with solid #8b89a8 ≈ 4.6:1 */
    --c-muted:   #8b89a8;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; }
  body {
    background: var(--c-bg);
    color: var(--c-text);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }
  h1,h2,h3,.font-display { font-family: 'Syne', sans-serif; }

  /* ── Screens ───────────────────────────────────────────────────── */
  .screen { display: none; min-height: 100vh; }
  .screen.active { display: flex; flex-direction: column; }

  /* ── Decorative backgrounds (aria-hidden in HTML) ─────────────── */
  .bg-dots {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image: radial-gradient(circle, rgba(124,92,252,0.12) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .bg-glow {
    position: fixed; pointer-events: none; z-index: 0;
    border-radius: 50%; filter: blur(80px); opacity: 0.15;
  }
  .glow-purple { width:400px; height:400px; background:#7c5cfc; top:-100px; right:-100px; }
  .glow-teal   { width:300px; height:300px; background:#4fd1c5; bottom:-80px; left:-80px; }
  .z1 { position: relative; z-index: 1; }

  /* ── Cards ─────────────────────────────────────────────────────── */
  .card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
  }
  .card-sm { border-radius: 12px; padding: 0.85rem 1.1rem; }

  /* ── Buttons ───────────────────────────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-family: 'Syne', sans-serif; font-weight: 600; font-size: 1rem;
    border: none; cursor: pointer; border-radius: 12px;
    padding: 0.8rem 1.75rem; transition: background 0.18s, box-shadow 0.18s, transform 0.1s;
    text-decoration: none; letter-spacing: 0.01em;
    /* WCAG 2.5.8: minimum 44px touch target height */
    min-height: 44px;
  }
  /* WCAG 2.4.11: visible focus indicator – 2px offset outline */
  .btn:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
  }
  .btn:active { transform: scale(0.97); }

  .btn-primary { background: var(--c-accent); color: #fff; }
  .btn-primary:hover { background: #6b4ef0; box-shadow: 0 0 24px rgba(124,92,252,0.4); }

  .btn-ghost { background: var(--c-surface2); color: var(--c-text); border: 1px solid var(--c-border); }
  .btn-ghost:hover { background: rgba(255,255,255,0.08); }

  /* btn-green: text #34d399 on #065f46 → 4.6:1 ✓ */
  .btn-green { background: #065f46; color: var(--c-green); border: 1px solid rgba(52,211,153,0.35); }
  .btn-green:hover { background: #047857; box-shadow: 0 0 20px rgba(52,211,153,0.3); }

  /* btn-red: text #f87171 on #450a0a → 5.0:1 ✓ */
  .btn-red { background: #450a0a; color: var(--c-red); border: 1px solid rgba(248,113,113,0.35); }
  .btn-red:hover { background: #7f1d1d; box-shadow: 0 0 20px rgba(248,113,113,0.3); }

  /* btn-hint: text #c4b5fd on #1c1a2e → 7.2:1 ✓ */
  .btn-hint { background: #1c1a2e; color: #c4b5fd; border: 1px solid rgba(196,181,253,0.3); }
  .btn-hint:hover { background: #2d2b4e; }

  .btn-xl { padding: 1.25rem 2.75rem; font-size: 1.1rem; border-radius: 16px; width: 100%; min-height: 56px; }
  .btn-sm { padding: 0.5rem 1rem; font-size: 0.85rem; border-radius: 8px; min-height: 44px; }

  /* ── Inputs & selects ──────────────────────────────────────────── */
  input[type="text"], input[type="number"], select {
    background: var(--c-surface2);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    color: var(--c-text);
    padding: 0.65rem 1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    /* WCAG 2.4.11: keep browser focus ring, override only colour */
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: border-color 0.15s, outline-color 0.15s;
    width: 100%;
    min-height: 44px;
  }
  input:focus-visible, select:focus-visible {
    border-color: var(--c-accent);
    outline-color: var(--c-accent);
  }
  select option { background: #1c1c27; }

  /* ── Timer ring ────────────────────────────────────────────────── */
  .timer-ring-wrap { position: relative; display: inline-flex; align-items: center; justify-content: center; }
  .timer-ring { transform: rotate(-90deg); }
  .timer-bg  { fill: none; stroke: rgba(255,255,255,0.08); }
  .timer-arc { fill: none; stroke-linecap: round; transition: stroke-dashoffset 1s linear, stroke 0.5s; }
  .timer-text {
    position: absolute; font-family: 'Syne', sans-serif;
    font-size: 1.8rem; font-weight: 800; color: var(--c-text);
    /* hidden from AT – aria-live region handles announcements */
    aria-hidden: true;
  }

  /* ── Scoreboard rows ───────────────────────────────────────────── */
  .score-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.75rem 1rem; border-radius: 10px;
    background: var(--c-surface2); border: 1px solid var(--c-border);
    transition: background 0.2s, border-color 0.2s;
  }
  .score-row.leader     { border-color: rgba(246,201,14,0.45); background: rgba(246,201,14,0.07); }
  .score-row.active-turn{ border-color: rgba(124,92,252,0.55); background: rgba(124,92,252,0.10); }

  /* ── Word display ──────────────────────────────────────────────── */
  .word-display {
    font-family: 'Syne', sans-serif;
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 800;
    text-align: center;
    line-height: 1.1;
    color: var(--c-text);
    letter-spacing: -0.02em;
  }

  /* ── Category badges ───────────────────────────────────────────── */
  .cat-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em;
    text-transform: uppercase; padding: 5px 14px; border-radius: 999px;
  }
  /* All badge contrast checked against their backgrounds ≥ 4.5:1 */
  .cat-persons { background: rgba(124,92,252,0.18); color: #d4c8ff; border: 1px solid rgba(124,92,252,0.35); }
  .cat-land    { background: rgba(79,209,197,0.14);  color: #7ffcf0; border: 1px solid rgba(79,209,197,0.35); }
  .cat-capital { background: rgba(246,201,14,0.12);  color: #f6c90e; border: 1px solid rgba(246,201,14,0.30); }

  /* ── Hint box ──────────────────────────────────────────────────── */
  .hint-box {
    background: rgba(196,181,253,0.07); border: 1px solid rgba(196,181,253,0.2);
    border-radius: 12px; padding: 1rem 1.25rem;
    /* #ddd6fe on #0a0a0f → 11.4:1 ✓ */
    font-size: 0.95rem; color: #ddd6fe; font-style: italic; line-height: 1.6;
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }

  /* ── Overtime panel ────────────────────────────────────────────── */
  .overtime-panel {
    background: rgba(246,201,14,0.06); border: 1px solid rgba(246,201,14,0.3);
    border-radius: 16px; padding: 1.5rem;
  }

  /* ── Confetti (decorative) ─────────────────────────────────────── */
  .confetti-piece {
    position: fixed; width: 10px; height: 10px; border-radius: 2px;
    animation: confettiFall linear forwards;
    pointer-events: none; z-index: 100;
    /* Will be given aria-hidden via JS */
  }
  @keyframes confettiFall {
    0%   { transform: translateY(-20px) rotate(0deg); opacity: 1; }
    100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
  }

  /* ── Pulse on CTA ─────────────────────────────────────────────── */
  @keyframes pulse-accent {
    0%,100% { box-shadow: 0 0 0 0 rgba(124,92,252,0.4); }
    50%     { box-shadow: 0 0 0 8px rgba(124,92,252,0); }
  }
  .pulse { animation: pulse-accent 2s infinite; }

  /* ── Toggle switch ─────────────────────────────────────────────── */
  .toggle { display: flex; align-items: center; gap: 10px; cursor: pointer; }
  /* WCAG: checkbox is visually hidden but still in tab order and AT-accessible */
  .toggle input[type="checkbox"] {
    position: absolute; opacity: 0; width: 44px; height: 24px;
    margin: 0; cursor: pointer;
  }
  /* Show focus ring on the visible track when keyboard-focused */
  .toggle input[type="checkbox"]:focus-visible + .toggle-track {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
  }
  .toggle-track {
    width: 44px; height: 24px; border-radius: 999px;
    background: var(--c-surface2); border: 1px solid var(--c-border);
    position: relative; transition: background 0.2s;
    flex-shrink: 0; pointer-events: none;
  }
  .toggle-thumb {
    position: absolute; top: 3px; left: 3px;
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--c-muted); transition: left 0.2s, background 0.2s;
  }
  .toggle input:checked + .toggle-track { background: var(--c-accent); border-color: var(--c-accent); }
  .toggle input:checked + .toggle-track .toggle-thumb { left: 23px; background: #fff; }

  /* ── Team colour dot ───────────────────────────────────────────── */
  .team-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

  /* ── Point flash animation ─────────────────────────────────────── */
  .point-flash {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
    font-family: 'Syne', sans-serif; font-size: 4rem; font-weight: 800;
    pointer-events: none; z-index: 50;
    animation: pointFlash 0.8s ease forwards;
  }
  @keyframes pointFlash {
    0%   { opacity:1; transform:translate(-50%,-50%) scale(0.8); }
    30%  { opacity:1; transform:translate(-50%,-80%) scale(1.2); }
    100% { opacity:0; transform:translate(-50%,-120%) scale(0.9); }
  }
  .flash-pos { color: var(--c-green); }
  .flash-neg { color: var(--c-red); }

  /* ── Scrollbar (cosmetic) ──────────────────────────────────────── */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

  /* ── Reduced-motion: disable non-essential animations ──────────── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    .pulse { animation: none; }
    .confetti-piece { display: none !important; }
  }

  @media (max-width: 480px) {
    .btn-xl { padding: 1rem 1.5rem; font-size: 1rem; }
    .word-display { font-size: clamp(1.8rem, 9vw, 3rem); }
  }

  /* ── Utility ───────────────────────────────────────────────────── */
  .gap-3 { gap: 0.75rem; }
  .gap-4 { gap: 1rem; }
  /* Visually hidden but accessible to screen readers */
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>
</head>
<body>

<!-- Purely decorative backgrounds – hidden from assistive technology -->
<div class="bg-dots" aria-hidden="true"></div>
<div class="bg-glow glow-purple" aria-hidden="true"></div>
<div class="bg-glow glow-teal"   aria-hidden="true"></div>

<!-- Live regions for screen-reader announcements -->
<div id="sr-live"       aria-live="polite"   aria-atomic="true" class="sr-only"></div>
<div id="sr-live-urgent" aria-live="assertive" aria-atomic="true" class="sr-only"></div>

<!-- ══════════════════════════════════════════════ SCREEN 1: OPPSETT -->
<main id="screen-setup" class="screen active" aria-label="Spilloppsett">
  <div class="z1 w-full max-w-lg mx-auto px-4 py-8 flex flex-col gap-6">

    <div class="text-center pt-4">
      <div class="cat-badge cat-land mx-auto mb-3" style="width:fit-content" aria-hidden="true">
        🎮 Norsk Alias
      </div>
      <h1 class="font-display text-4xl font-black" style="letter-spacing:-0.03em">ALIAS</h1>
      <p style="color:var(--c-muted);margin-top:6px;font-size:0.95rem">Forklar ordet – vinn runden!</p>
    </div>

    <!-- Lag-seksjon -->
    <section class="card" aria-labelledby="teams-heading">
      <div class="flex items-center justify-between mb-4">
        <h2 id="teams-heading" class="font-display text-lg font-bold">Lag</h2>
        <button class="btn btn-ghost btn-sm" onclick="addTeam()" aria-label="Legg til et nytt lag">
          + Legg til lag
        </button>
      </div>
      <div id="teams-list" class="flex flex-col gap-3" role="list" aria-label="Lagliste"></div>
    </section>

    <!-- Innstillinger-seksjon -->
    <section class="card" aria-labelledby="settings-heading">
      <h2 id="settings-heading" class="font-display text-lg font-bold mb-4">Spillinnstillinger</h2>
      <div class="flex flex-col gap-4">

        <div>
          <label for="target-score" style="font-size:0.85rem;color:var(--c-muted);display:block;margin-bottom:6px">
            Poengmål (vinnerpoeng)
          </label>
          <select id="target-score">
            <option value="20">20 poeng</option>
            <option value="30" selected>30 poeng</option>
            <option value="40">40 poeng</option>
            <option value="50">50 poeng</option>
          </select>
        </div>

        <div>
          <label for="round-time" style="font-size:0.85rem;color:var(--c-muted);display:block;margin-bottom:6px">
            Tid per runde
          </label>
          <select id="round-time">
            <option value="45">45 sekunder</option>
            <option value="60" selected>60 sekunder</option>
            <option value="90">90 sekunder</option>
          </select>
        </div>

        <fieldset style="border:none;padding:0">
          <legend style="font-size:0.85rem;color:var(--c-muted);margin-bottom:8px">Kategorier</legend>
          <div class="flex flex-col gap-3">
            <label class="toggle">
              <input type="checkbox" id="cat-persons" checked aria-describedby="cat-persons-desc">
              <div class="toggle-track" aria-hidden="true"><div class="toggle-thumb"></div></div>
              <span><span aria-hidden="true">👤</span> Kjente personer</span>
              <span id="cat-persons-desc" class="sr-only">Aktiver kategorien Kjente personer</span>
            </label>
            <label class="toggle">
              <input type="checkbox" id="cat-land" checked>
              <div class="toggle-track" aria-hidden="true"><div class="toggle-thumb"></div></div>
              <span><span aria-hidden="true">🌍</span> Land</span>
            </label>
            <label class="toggle">
              <input type="checkbox" id="cat-capital" checked>
              <div class="toggle-track" aria-hidden="true"><div class="toggle-thumb"></div></div>
              <span><span aria-hidden="true">🏛️</span> Hovedstader</span>
            </label>
          </div>
        </fieldset>
      </div>
    </section>

    <button class="btn btn-primary btn-xl" onclick="startGame()">
      Start spillet <span aria-hidden="true">▶</span>
    </button>
  </div>
</main>

<!-- ══════════════════════════════════════════════ SCREEN 2: DASHBOARD -->
<main id="screen-dashboard" class="screen" aria-label="Rundevisning" aria-hidden="true">
  <div class="z1 w-full max-w-lg mx-auto px-4 py-8 flex flex-col gap-5">

    <div class="text-center">
      <p style="font-size:0.8rem;letter-spacing:0.12em;color:var(--c-muted);text-transform:uppercase;margin-bottom:4px" aria-hidden="true">
        Neste runde
      </p>
      <h2 class="font-display text-3xl font-black" id="dash-team-name">Lag 1 sin tur</h2>
      <div id="dash-team-dot" class="mx-auto mt-2 team-dot" aria-hidden="true"></div>
    </div>

    <section class="card" aria-labelledby="dash-score-heading">
      <h3 id="dash-score-heading" class="font-display text-sm font-bold mb-3"
          style="color:var(--c-muted);text-transform:uppercase;letter-spacing:0.1em">Stillingen</h3>
      <div id="dash-scoreboard" class="flex flex-col gap-2" role="list" aria-label="Poengstilling"></div>
    </section>

    <div class="card" style="background:rgba(124,92,252,0.08);border-color:rgba(124,92,252,0.3)"
         aria-label="Rundeinfo">
      <div class="flex justify-between items-center">
        <div>
          <p style="font-size:0.8rem;color:var(--c-muted)" id="dash-round-label">Runde</p>
          <p class="font-display text-2xl font-bold" id="dash-round" aria-labelledby="dash-round-label">1</p>
        </div>
        <div style="text-align:right">
          <p style="font-size:0.8rem;color:var(--c-muted)" id="dash-target-label">Poengmål</p>
          <p class="font-display text-2xl font-bold" id="dash-target" aria-labelledby="dash-target-label">30</p>
        </div>
        <div style="text-align:right">
          <p style="font-size:0.8rem;color:var(--c-muted)" id="dash-time-label">Tid</p>
          <p class="font-display text-2xl font-bold" id="dash-time" aria-labelledby="dash-time-label">60s</p>
        </div>
      </div>
    </div>

    <div id="final-round-notice" class="card" hidden
         style="background:rgba(246,201,14,0.06);border-color:rgba(246,201,14,0.35);text-align:center"
         role="status">
      <p style="color:var(--c-gold);font-weight:600">
        <span aria-hidden="true">⚠️</span> Utjevningsrunde pågår!
      </p>
      <p style="font-size:0.85rem;color:var(--c-muted);margin-top:4px">
        Alle lag spiller sin siste runde for rettferdig avslutning.
      </p>
    </div>

    <button class="btn btn-primary btn-xl pulse" onclick="startRound()">
      Start runden <span aria-hidden="true">🎯</span>
    </button>
  </div>
</main>

<!-- ══════════════════════════════════════════════ SCREEN 3: SPILLBRETT -->
<main id="screen-game" class="screen" aria-label="Spill pågår" aria-hidden="true">
  <div class="z1 w-full max-w-lg mx-auto px-4 py-6 flex flex-col gap-4" style="min-height:100vh">

    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <p style="font-size:0.75rem;color:var(--c-muted);letter-spacing:0.1em;text-transform:uppercase" aria-hidden="true">
          Forklarer
        </p>
        <p class="font-display font-bold" id="game-team-name" style="font-size:1.1rem"
           aria-label="Laget som forklarer: Lag 1">Lag 1</p>
      </div>
      <div class="flex items-center gap-3">
        <!-- Score card -->
        <div class="card card-sm" style="padding:6px 14px;text-align:center">
          <p style="font-size:0.7rem;color:var(--c-muted)" id="score-label">Poeng</p>
          <p class="font-display font-bold text-lg" id="game-score"
             aria-labelledby="score-label" aria-live="polite">0</p>
        </div>
        <!-- Timer -->
        <div class="timer-ring-wrap"
             role="timer"
             aria-label="Nedtelling"
             aria-describedby="timer-display">
          <svg class="timer-ring" width="70" height="70" viewBox="0 0 70 70" aria-hidden="true">
            <title>Nedtellingssirkel</title>
            <circle class="timer-bg" cx="35" cy="35" r="30" stroke-width="5"/>
            <circle id="timer-arc" class="timer-arc" cx="35" cy="35" r="30" stroke-width="5"
              stroke-dasharray="188.5" stroke-dashoffset="0" stroke="#7c5cfc"/>
          </svg>
          <span class="timer-text" id="timer-display" aria-hidden="true">60</span>
        </div>
        <!-- Screen-reader-only live timer announcements every 10s are handled in JS -->
      </div>
    </div>

    <!-- Category -->
    <div class="text-center">
      <span id="game-cat-badge" class="cat-badge cat-persons" role="status">Kjente personer</span>
    </div>

    <!-- Word -->
    <div class="card flex flex-col items-center justify-center"
         style="min-height:160px;padding:2rem;text-align:center;"
         aria-live="polite" aria-atomic="true" aria-label="Gjeldende ord">
      <p class="word-display" id="game-word">LASTER…</p>
    </div>

    <!-- Hint -->
    <div>
      <button class="btn btn-hint w-full" onclick="toggleHint()" id="hint-btn"
              aria-expanded="false" aria-controls="hint-box">
        <span aria-hidden="true">💡</span> Vis hint
      </button>
      <div id="hint-box" class="hint-box mt-3" hidden
           role="complementary" aria-label="Hint på engelsk"></div>
    </div>

    <!-- Action buttons -->
    <div class="flex gap-3" role="group" aria-label="Spillhandlinger">
      <button class="btn btn-red flex-1"
              style="flex-direction:column;gap:4px;padding:1rem 0.5rem;"
              onclick="wrongAnswer()"
              aria-label="Hopp over eller feil svar, minus ett poeng">
        <span aria-hidden="true" style="font-size:1.3rem">✗</span>
        <span style="font-size:0.85rem">Hopp over / Feil</span>
        <span style="font-size:0.7rem;color:var(--c-muted)" aria-hidden="true">−1 poeng</span>
      </button>
      <button class="btn btn-green flex-1"
              style="flex-direction:column;gap:4px;padding:1rem 0.5rem;"
              onclick="correctAnswer()"
              aria-label="Riktig svar, pluss ett poeng">
